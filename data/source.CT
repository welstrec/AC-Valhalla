    <CheatEntry>
      <ID>24113</ID>
      <Description>"+Inventory // GetItems"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>FF8000</Color>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>93358</ID>
          <Description>"***Inventory: patch to keep cheated items***"</Description>
          <Options moHideChildren="1"/>
          <Color>0080FF</Color>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>93360</ID>
              <Description>"patch file"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript Async="1">{$lua}
local status = {
[0]="Exe file has been successfuly patched, relaunch game for changes to take effect.",
[1]="Attach to the Assassin's Creed Valhalla process.",
[2]="Did not find a spot to patch, check AOB.",
[3]="More than one spot to patch found, don't know what to patch.",
[4]="Exe file is already patched, skipping.",
[5]="Unknown signature found at patch spot, skipping."
}

local IMAGE_SCN_CNT_CODE=0x20
local IMAGE_SCN_MEM_EXECUTE=0x20000000
local function getFileOffset(memstream,offset) --convert process offset to file offset
  --kudos to DarkByte for the code
  --C:\Program Files\Cheat Engine x.x\autorun\patchscan.lua
  memstream.Position=0
  if (byteTableToString(memstream.read(2))~='MZ') then
    return nil, 'Not a valid executable'
  end

  memstream.Position=60;
  local lfanew=memstream.readDword();
  memstream.Position=lfanew;

  if (byteTableToString(memstream.read(2))~='PE') then
    return nil, 'Not a valid windows executable'
  end

  memstream.Position=memstream.Position+2
  local Machine=memstream.readWord()
  local SectionCount=memstream.readWord()
  memstream.Position=memstream.Position+12
  local OptHeaderSize=memstream.readWord()
  memstream.Position=memstream.Position+2

  local OptHeaderStart=memstream.Position
  local Magic=memstream.readWord()
  local MajorLinkerVersion=memstream.readByte()
  local MinorLinkerVersion=memstream.readByte()

  local SizeOfCode=memstream.readDword()
  memstream.Position=memstream.Position+8
  local EntryPoint=memstream.readDword()
  local BaseOfCode=memstream.readDword()

  local BaseOfData
  local ImageBase
  --scan the reloc table
  if Machine==0x8664 then --x64
    BaseOfData=nil
    ImageBase=memstream.readQword()
    memstream.Position=memstream.Position+4+4+2+2+2+2+2+2+4+4+4+4+2+2+8+8+8+8
  else
    BaseOfData=memstream.readDword()
    ImageBase=memstream.readDword()
    memstream.Position=memstream.Position+4+4+2+2+2+2+2+2+4+4+4+4+2+2+4+4+4+4
  end
  --local RelocDistance=loadedModuleBase-ImageBase;

  local LoaderFlags=memstream.readDword()
  local RVACount=memstream.readDword()

  if RVACount~=16 then
    return nil, 'This type of module is currently not supported'
  end

  --DataDirectory follows
  local DataDirPosition=memstream.Position
  local ImageSectionHeaderPosition=OptHeaderStart+OptHeaderSize

  --parse the sections so VirtualToFile can function
  local sections={}
  memstream.Position=ImageSectionHeaderPosition

  local i
  for i=1,SectionCount do
    sections[i]={}
    sections[i].name=byteTableToString(memstream.read(8))
    sections[i].misc=memstream.readDword()
    sections[i].virtualAddress=memstream.readDword()
    sections[i].sizeOfRawData=memstream.readDword()
    sections[i].PointerToRawData=memstream.readDword()
    memstream.Position=memstream.Position+12;
    sections[i].Characteristics=memstream.readDword()
    sections[i].Executable=sections[i].Characteristics &amp; IMAGE_SCN_CNT_CODE == IMAGE_SCN_CNT_CODE
  end

  local function VirtualToFile(VA)
    --scan the address in the sections list
    local i
    for i=1,#sections do
      if (VA&gt;=sections[i].virtualAddress) and (VA&lt;sections[i].virtualAddress+sections[i].sizeOfRawData) then
        return sections[i].PointerToRawData+(VA-sections[i].virtualAddress)
      end
    end
    return nil, string.format("Process offset %016X was not found among file sections.",VA)
  end
  return VirtualToFile(offset)
end

local function getPath(mem)
  local call = getAddressSafe("kernel32.GetModuleFileNameW");
  local r,ret
  if call then
    r = executeCodeEx(0, -1, call, {0,0},{0,mem},{0,1000} )
    if r &gt; 0 then
      ret = {readString(t, 500, true)}
    elseif r == 0 then
      --todo: GetLastError, FormatMessage
      ret = {nil,"Failed to call kernel32.GetModuleFileNameW"}
    end
  else
    ret = {nil, "Can't get address of kernel32.GetModuleFileNameW"}
  end
  return unpack(ret)
end

local function renameFile(old, new)
  local MOVEFILE_REPLACE_EXISTING = 0x1
  local MOVEFILE_WRITE_THROUGH = 0x8
  local call = getAddressSafe("kernel32.MoveFileExW");
  local r,ret
  if call then
    r =  executeCodeEx(0, -1, call, {4,old}, {4,new}, {0,MOVEFILE_REPLACE_EXISTING+MOVEFILE_WRITE_THROUGH} )
    if r &gt; 0 then
      ret = {true}
    elseif r == 0 then
      --todo: GetLastError, FormatMessage
      ret = {nil, "Failed to call kernel32.MoveFileExW"}
    end
  else
    ret = {nil, "Can't get address of kernel32.MoveFileExW"}
  end
  return unpack(ret)
end

local function reportStatus(msg)
  if not PATCH_mrinfo then
    PATCH_mrinfo = AddressList.createMemoryRecord();
    PATCH_mrinfo.appendToEntry(memrec);
  end;
  PATCH_mrinfo.Description   = msg
  PATCH_mrinfo.color         = 0x0000ff;
  PATCH_mrinfo.IsGroupHeader = true;
  PATCH_mrinfo.DontSave      = true;
end

local function AOBScanEx(aob)
  -- kudos to panraven for the code
  -- https://forum.cheatengine.org/viewtopic.php?t=577536
  local p, a, n, s, e = nil or '*X*W', nil or fsmNotAligned, nil or '0', getAddress( process ) or 0x0, ( getAddress( process ) + getModuleSize( process ) ) or 0xffffffffffffffff
  local ms = pb and createMemScan( pb ) or createMemScan()
  local fl = createFoundList( ms )
  ms.firstScan( soExactValue, vtByteArray, nil, aob, nil, s, e, p, a, n, true, false, false, false )
  ms.waitTillDone()
  fl.initialize()
  local result = nil
  if fl ~= nil and fl.getCount() &gt; 0 then
    result = createStringlist()
    for i = 1, fl.getCount() do result.add( fl.getAddress( i - 1 ) ) end
  end
  fl.destroy()
  ms.destroy()
  return result
end

local PATCH_aob1     = "?? ?? ?? ?? ?? ?? ?? 4D 8B C4 48 89 4D C0 33 C9"
local PATCH_newQword1= 0x4D40498B480E8B48
local PATCH_oldQword1= 0x4D000000000D8D48
local PATCH_mask1    = 0xFF00000000FFFFFF

local PATCH_aob2     = "?? ?? ?? 45 33 C9 89 44 24 20 45 8D 41 01"
local PATCH_newQword2= 0x4489C93345D23148
local PATCH_oldQword2= 0x4489C93345138B48
local PATCH_mask2    = 0xFFFFFFFFFFFFFFFF

[ENABLE]
  if (not process) or (not readInteger(process)) then reportStatus(status[1]);return; end;
  local patchAOB1 = AOBScanEx(PATCH_aob1)
  local patchAOB2 = AOBScanEx(PATCH_aob2)

  if not patchAOB1          then reportStatus(status[2]); return; end; --exit on error
  if not patchAOB2          then reportStatus(status[2]); return; end; --exit on error
  if patchAOB1.getCount()&gt;1 then reportStatus(status[3]); return; end; --exit on error
  if patchAOB2.getCount()&gt;1 then reportStatus(status[3]); return; end; --exit on error


  t = allocateMemory( 0x1000 ) --global
  local path,r,e
  local original  = createMemoryStream()
        path,e    = getPath(t);                          if not path    then reportStatus(e); return; end; --exit on error
        r,e       = original.loadFromFileNoError(path);  if not r       then reportStatus(e); return; end; --exit on error
  local poffset1  = tonumber(patchAOB1[0],16)-getAddressSafe(process)
  local poffset2  = tonumber(patchAOB2[0],16)-getAddressSafe(process)

  local foffset1,e= getFileOffset(original, poffset1);   if not foffset1 then reportStatus(e); return; end; --exit on error
  local foffset2,e= getFileOffset(original, poffset2);   if not foffset2 then reportStatus(e); return; end; --exit on error

  original.Position = foffset1
  local spot1 = original.readQword();                    if spot1 == PATCH_newQword1 then reportStatus(status[4]); return; end; --exit on error
  original.Position = foffset2
  local spot2 = original.readQword();                    if spot2 == PATCH_newQword2 then reportStatus(status[4]); return; end; --exit on error

  outputDebugString(string.format(":: mem: %016X path: %s",t,path ) )
  outputDebugString(string.format(":: file/process offset1 -- offset2 : %016X / %016X %016X / %016X", foffset1, poffset1,foffset2, poffset2 ))

  if (bAnd(spot1,PATCH_mask1) == PATCH_oldQword1) and (bAnd(spot2,PATCH_mask2) == PATCH_oldQword2) then
    r,e = renameFile(path, path..'.bak');                if not r        then reportStatus(e); return; end; --exit on error
    original.Position = foffset1; original.writeQword(PATCH_newQword1)
    original.Position = foffset2; original.writeQword(PATCH_newQword2)

    r,e = original.saveToFileNoError(path)
      -- TODO: to enable when CE is upgraded to 7.3+
      -- if not r then reportStatus(e); return; end; --exit on error
    reportStatus(status[0])
    return
  end

  reportStatus(status[5])
  --original.destroy()

[DISABLE]
  deAlloc(t); t = nil;
  if PATCH_mrinfo then PATCH_mrinfo.Delete(); PATCH_mrinfo = nil; end;
</AssemblerScript>
            </CheatEntry>
            <CheatEntry>
              <ID>93361</ID>
              <Description>"patch process"</Description>
              <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
  aobScanModule( PATCH_aob1,  $process, ?? ?? ?? ?? ?? ?? ?? 4D 8B C4 48 89 4D C0 33 C9 )
  aobScanModule( PATCH_aob2,  $process, ?? ?? ?? 45 33 C9 89 44 24 20 45 8D 41 01 )
  alloc(PATCH_newmem1, 7)
  alloc(PATCH_newmem2, 3)

  registerSymbol( PATCH_aob1,PATCH_aob2,PATCH_newmem1,PATCH_newmem2 )

  PATCH_newmem1:
    readmem(PATCH_aob1, 7)
  PATCH_newmem2:
    readmem(PATCH_aob2, 3)

  PATCH_aob1:
    mov rcx, [rsi]
    mov rcx, [rcx+40]

  PATCH_aob2:
    xor rdx, rdx

[DISABLE]
  PATCH_aob1:
    readmem(PATCH_newmem1, 7)   //Helix

  PATCH_aob2:
    readmem(PATCH_newmem2, 3)   //DLC

  dealloc(*)
  unregisterSymbol(*)
</AssemblerScript>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>89970</ID>
          <Description>"+Inventory: GetItem"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <Color>804000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
  aobScanModule( GI_call1, $process, 48 89 5C 24 08 48 89 6C 24 10 48 89 74 24 18 48 89 7C 24 20 41 56 48 81 EC E0 00 00 00 48 8B D9 )
  aobScanModule( GI_aob1,  $process, 48 8B 0D ?? ?? ?? ?? 33 D2 48 81 C1 80 04 00 00 E8 ?? ?? ?? ?? 48 8B D8 )
  aobScanModule( GI_aobE,  $process, 48 8B 05 ?? ?? ?? ?? 8B 90 ?? ?? 00 00 3? ?? 0F 93 ?0 C3 )
  aobScanModule( GI_aobF,  $process, FF 50 18 48 8B 03 48 ?? ?? C7 83 ?4 00 00 00 01 00 00 00 )

  globalAlloc( GI_newmem,$2000 )
  registerSymbol( GI_TLock,GI_dqIID,GI_pIIDList )

  CreateThread( GI_main_asm )

  GI_newmem:
    GI_getvar:
      mov eax, dword ptr[rcx+rdx]
      movsxd rax, eax
      lea rax, qword ptr[rcx+rax]
      add rax, r8d
      mov qword ptr[r9], rax
      ret
      align 10 CC
    GI_getvars:
      sub rsp,20
      mov r9,  GI_var01
      mov r8,  7
      mov rdx, 3
      mov rcx, GI_aob1
      call short GI_getvar
      add rsp,20
      ret
      align 10 CC
    GI_setFlags:
      mov rax, [GI_var01]
      mov rax,[rax]
      add rax, 480
      mov [pFlag], rax
      mov rcx, [rax]
      mov [flag], rcx
      mov [rax], 02
      ret
      align 10 CC
    GI_restoreFlags:
      mov rdx, [flag]
      mov rcx, [pFlag]
      mov [rcx], rdx
      ret
      align 10 CC

    GI_tcreate:
      sub rsp, 20
      reassemble(GI_aobE)
      mov rax, [rax]
      call [rax+18]
      add rsp, 20
      ret
      align 10 CC
    GI_tdestroy:
      sub rsp, 20
      reassemble(GI_aobE)
      mov rax, [rax]
      call [rax+20]
      add rsp, 20
      ret
      align 10 CC

    GI_getItem:
      mov [rsp+08], rsi
      mov [rsp+10], r15
      sub rsp, 40
      sleep_loop:
        mov rcx, #100
        mov rax, kernel32.sleep
        call rax
        cmp byte ptr [GI_TLock+0], 0
        je short sleep_loop
        cmp byte ptr [GI_TLock+0], 1
        je short proceed
        cmp byte ptr [GI_TLock+0], 2
        je short exit_A
      exit_A:
        add rsp, 40
		mov rsi,[rsp+08]
		mov r15,[rsp+10]
        ret
      proceed:
        call short GI_setFlags
        cmp byte ptr [GI_TLock+1], 1
        jz @f
          mov r15, GI_pIIDList
          mov rsi, GI_pIIDList+8
          jmp get_loop
        @@:
          mov r15, GI_dqIID
          mov rsi, GI_dqIID+8
        get_loop:
          mov qword ptr [rsp+30], 2
          mov qword ptr [rsp+28], 1
          mov qword ptr [rsp+20], 3
          mov r9, 2
          mov r8, 0
          mov edx, [r15]
          mov rcx, [rsi]
          mov rax, GI_call1
          call rax
          add rsi, 8
          cmp [rsi], 0
          je short exit_loop
          jmp get_loop
        exit_loop:
          mov byte ptr [GI_TLock+0], 0
          call short GI_restoreFlags
          jmp sleep_loop
          align 10 CC

    GI_main_asm:
      sub rsp, 20
      call short GI_getvars
      call short GI_tcreate
      call short GI_getItem
      call short GI_tdestroy
      add rsp, 20
      ret
      align 10 CC

    pFlag:
      dq 0
      align 10 CC
    flag:
      dq 12345678
      align 10 CC
    GI_var01:
      dq 0
      align 10 CC
    GI_TLock:
      db 0
      db 1
      align 10 CC
    GI_dqIID:
      dq 0000000000000001
      dq 000001AF7031F3F9
      dq 0000000000000000
      align 10 CC

    GI_pIIDList:
      dq 0000000000000000


[DISABLE]
  GI_TLock:
    db 2
    db -1

  unregisterSymbol(*)
</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>89971</ID>
              <Description>"+Single GetItem"</Description>
              <Options moHideChildren="1"/>
              <Color>008000</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
  local activate = function(record, before, currentstate)
    --outputDebugString("::OnActivate"..(before and "Before " or "After ")..(currentstate and "true" or "false"));
    if before then
      if record.Description == "Toggle to Get Item" then
        return true;
      else
        return false;  --block activation to avoid corruption
      end
    end
    return true;
  end

  for i=0, memrec.count-1, 1 do
    memrec[i].OnActivate = activate;
  end

[DISABLE]


</AssemblerScript>
