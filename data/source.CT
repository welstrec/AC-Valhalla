          <Color>804000</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
  aobScanModule( INVEI_inject, $process, 48 8B 83 D8 04 00 00 48 8D 8F 80 02 00 00  )
  alloc( INVEI_newmem, 1000 )
  registerSymbol( INVEI_inject,INVEI_pItemPtr )

  INVEI_newmem:
    //original code
      mov rax, [rbx+4D8]
      lea rcx, [rdi+280]
    //inject
      mov [INVEI_pItemPtr], rcx
      jmp return_inventory
      align 10 CC

    INVEI_pItemPtr:
      dq 0
      align 10 CC

  INVEI_inject:
    jmp far INVEI_newmem
    return_inventory:


