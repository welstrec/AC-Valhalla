  registerSymbol( INVEQ_pInvVector,INVEQ_main_asm,INVEQ_getInv )
  registerSymbol( INVEQ_newmem_strings )

  //createThread( INVEQ_main_asm )

  INVEQ_newmem:
    INVEQ_getvar:
      mov eax,dword ptr [rcx+rdx]
      movsxd rax,eax
      lea rax,qword ptr [rcx+rax]
      add rax,r8d
      mov qword ptr [r9],rax
      ret
      align 10 CC

    INVEQ_getvars:
      //mov r9,  INVEQ_pcall3
      //mov r8,  5
      //mov rdx, 1
      //mov rcx, INVEQ_aob1
      //call short INVEQ_getvar
	  mov r9,  INVEQ_pcall3
      mov rax, INVEQ_aob1
      mov qword ptr [r9],rax
      mov r9,  INVEQ_pcall4
      mov r8,  5
      mov rdx, 1
      mov rcx, INVEQ_aob5+15
      call short INVEQ_getvar
      mov r9,  INVEQ_pcall2
      mov r8,  5
      mov rdx, 1
      mov rcx, INVEQ_aob2+1A
      call short INVEQ_getvar
      mov r9,  INVEQ_pcall1
      mov r8,  5
      mov rdx, 1
      mov rcx, INVEQ_aob4
      call short INVEQ_getvar
      mov r9,  INVEQ_idx
      mov r8,  7
      mov rdx, 3
      mov rcx, INVEQ_aob3
      call short INVEQ_getvar
        test rax,rax
        jz @f
        mov rax, [rax]
        mov [INVEQ_idx], rax
      @@:

      ret
      align 10 CC

    INVEQ_getName:
      sub rsp, 28
      mov rax, [rcx+10]
      mov rcx, [rax+8]
      shl rcx, 20
      sar rcx, 3F
      and rcx, [rax]
      je @f
        mov rax, INVEQ_pcall3
        call [rax]
        mov r8, 1
        lea rdx, [rsp+20]
        mov qword ptr [rdx], 0
        mov rcx, rax
        mov rax, INVEQ_pcall4
        call [rax]
        mov rax, [rsp+20]
        add rsp, 28
        ret
      @@:
        xor rax, rax
        add rsp, 28
        ret
        align 10 CC

    INVEQ_getStrings:
      mov [rsp+08], r12
      mov [rsp+10], rbx
      mov [rsp+18], r14
      sub rsp,20
      test rcx,rcx
      jz loop_exit
        mov r14, INVEQ_newmem_strings
        mov r12, [rcx]
        mov ecx, [rcx+8]
        and ecx, 7FFF
        lea rbx,[rcx+rcx*8]
        shl ebx, 3
        add rbx, r12
        cmp rbx, r12
        je loop_exit
      loop_run:
        mov rcx, r12
        call INVEQ_getName
        mov [r14], rax
        add r14, 08
        add r12, 48
        cmp rbx, r12
        jne loop_run
      loop_exit:
        add rsp,20
        mov r12, [rsp+08]
        mov rbx, [rsp+10]
        mov r14, [rsp+18]
        ret
        align 10 CC

    INVEQ_getInv:
      sub rsp, 20
        mov rax, INVEQ_pcall1
        call [rax]
        test rax, rax
        jz @f
          mov rcx, [rax+15F8]
          test rcx, rcx
          jz @f
            mov rax, INVEQ_pcall2
            call [rax]
            test rax, rax
            jz @f
              mov rcx, [rax+70]
              mov rax, [rcx]
              call qword ptr [rax+0A0]
                mov rdx, [INVEQ_idx]
                movzx ecx, byte ptr [rdx+41]
                mov rax, [rax]
                mov rcx, [rax+rcx*8]
                test rcx, rcx
                jz @f
                  add rcx, FFFFFFFFFFFFFCD0
                  add rcx, 0C
                  mov rax, rcx
                  add rsp, 20
                  ret
      @@:
      xor rax, rax
      add rsp, 20
      ret
      align 10 CC

    INVEQ_main_asm:
      sub rsp, 20
        call INVEQ_getvars
        call short INVEQ_getInv
        mov qword ptr [INVEQ_pInvVector], rax
        test rax,rax
        jz @f
          mov rdx,[rax]
          mov qword ptr [INVEQ_pInvVector+08],rdx
          mov edx,[rax+8]
          mov dword ptr [INVEQ_pInvVector+10],edx
          mov rcx, rax
          call short INVEQ_getStrings
      @@:
      add rsp, 20
      ret
      align 10 CC

    INVEQ_pcall3:
      dq 0
      align 10 CC
    INVEQ_pcall4:
      dq 0
      align 10 CC
    INVEQ_pInvVector:
      dq 0
      dq 0
      dd 0
      align 10 CC
    INVEQ_pcall2:
      dq 0
      align 10 CC
    INVEQ_pcall1:
      dq 0
      align 10 CC
    INVEQ_idx:
      dq 0
      align 10 CC
    INVEQ_newmem_strings:
  ]]..
"\r\n[DISABLE]\r\n"..
[[
  dealloc(*)
  unregisterSymbol(*)
]]

  if syntaxcheck then
   local checkOk, errMsg = autoAssembleCheck(INVEQ_script)
   if not checkOk then ShowMessage(errMsg)  end
   return
  end

[ENABLE]
  local strTopCat = "+All Inventory Items (%d)";
  local strCat    = {
                     {{"Armor","Disguise"},"🛡"},
                     {{"Rune"},"🔹"},
                     {{"Tattoo","Beard","Hair","CosmeticScheme"},"◌"},
                     {{"Weapon"},"⚔"},
                     {{"Rideable","Eagle"},"🐎🦅"},
                     {{"PlayerShipPartCustomization"},"⚓"},
                     {{"Collectibles","CommonGoods"},"📜"},
                     {{"Order Member Clue"},"🗞"}
                  }
  local mrinv_cat = {};
  local dwCat     = {};

      for i=1, #strCat, 1 do
        mrinv_cat[i] = nil;
        dwCat[i]     = 0;
      end

  --[[
  Armor - Bracers / Armor - Helmet / Armor - Pants / Armor - Torso /   Disguise
  Rune
  Tattoo / Beard / Hair / CosmeticScheme
  Weapon
  Rideable / Eagle
  PlayerShipPartCustomization
  Collectibles / CommonGoods
  Order Member Clue

  Mask
  Arrow
  HiddenBlade
  Cargo
  Edible
  Money
  Dice GodPower Card
  Quest Items
  Crafting Materials
  Head
  Hood
  Equipment
  Purse
  Consummable
  Ballistic - Rock
  BookOfKnowledge
  Keys
  AC_Old
  ]]--
  local bRunCrt   = true;
  local bRunTop   = true;
  INVEQ_mrinv     = nil; --global
  INVEQ_mrinfo    = nil --global

  local activate = function(record, before, currentstate)
    --outputDebugString("::OnActivate"..(before and "Before " or "After ")..(currentstate and "true" or "false"));
    if before then
      if record == INVEQ_mrinv then
        return true;
      else
        return false;  --block activation to avoid inv corruption
      end
    end
    return true;
  end

  local deactivate = function(record, before, currentstate)
    if before then
    end
    --outputDebugString("::OnDeactivate"..(before and "Before " or "After ")..(currentstate and "true" or "false"));
    return true
  end

  local CreateInvRecs = function(addr, names, complete, iid, cat, proceed, proceedtop)
    local call, ret, mr, name = nil,nil,nil,nil;

    if proceedtop then
      INVEQ_mrinv = AddressList.createMemoryRecord();
      INVEQ_mrinv.Description   = string.format(strTopCat, complete);
      INVEQ_mrinv.Options       = "[moHideChildren],[moDeactivateChildrenAsWell]"
      INVEQ_mrinv.IsGroupHeader = true;
      INVEQ_mrinv.DontSave      = true;
      INVEQ_mrinv.appendToEntry(memrec);

      for i=1, #strCat, 1 do
         --dwCat[i] = 0;
        mrinv_cat[i] = AddressList.createMemoryRecord();
        mrinv_cat[i].Description   = "+"..strCat[i][2]..table.concat(strCat[i][1] , "/").." ("..dwCat[i]..")"
        mrinv_cat[i].Options       = "[moHideChildren],[moDeactivateChildrenAsWell]"
        mrinv_cat[i].IsGroupHeader = true;
        mrinv_cat[i].DontSave      = true;
        mrinv_cat[i].appendToEntry(INVEQ_mrinv);
      end

      bRunTop = false

      for i=0, memrec.count-1, 1 do
        memrec[i].OnActivate = activate;
      end
    end --if

    if proceed then
      name = readString(readQword(names+(complete-1)*8) or 0, 1500, true) or "";
      mr = AddressList.createMemoryRecord();
      mr.Type           = vtDword;
      mr.Address        = addr;
      mr.Description    = string.format("%016X / %s", iid, name);
      mr.DontSave       = true;
      mr.OnActivate     = activate;

      local bCatDef = false;
      local bCat = {};
      for i=1,#strCat,1 do bCat[i]=false; end

      for j=1,#strCat,1 do
        for i=1,#strCat[j][1],1 do
          if cat:find(strCat[j][1][i],1,true)==1 then
            bCat[j] = true;
            dwCat[j] = dwCat[j]+1;
            mrinv_cat[j].Description   = "+"..strCat[j][2]..table.concat(strCat[j][1] , "/").." ("..dwCat[j]..")"
            mr.appendToEntry(mrinv_cat[j]);
            break;
          end
        end
        bCatDef = (bCatDef or bCat[j])
      end
      if not bCatDef then
        mr.appendToEntry(INVEQ_mrinv);
      end
      INVEQ_mrinv.Description   = string.format(strTopCat, complete);
    end --if proceed

  end

  local INVEQ_main_lua = function( InvStart, names, slotsize )
    res = nil; res = {}; --global
    local s, pItem, dqIID, dwCount, s5, s6
    local t1, t2, t3, t4, t5, t6, t7
    local a;
    local dwSlotSize = slotsize
    local startaddr = InvStart;
          a = readInteger( startaddr + 8 ) or 0;
          a = bAnd(a,0x7FFF)*dwSlotSize-dwSlotSize;
          startaddr = readQword( startaddr ) or 0;
    local endaddr = startaddr+a;


    --outputDebugString("::"..string.format("%016X %016X",InvStart,names))

    --for i=1, #strCat, 1 do dwCat[i] = 0; end;
    if InvStart == 0 then
     showMessage("Can't find Inventory. Disable cheat and try again later.")
     return
    end

    outputDebugString("::pInvSlot\tpItem\tIID\tCount\tCat\tSubCat")

    for p = startaddr, endaddr, dwSlotSize do
                                      --ACValhalla specific
      pItem = readQword(p+0x08) or 0; --InventoryItemSettings
      dqIID = readQword(pItem+0x10) or 0;
      dwCount = readInteger(p) or -1;

      t1 = readQword(pItem) or 0 ;  t2 = readQword(t1+0x10) or 0;
      t3 = readQword(t2+0) or 0;  t4 = readQword(t3+0x10) or 0;
      s5 = readString(t4+0) or "0"; s5 = s5:gsub("\n", " "); s5 = s5:gsub("\r", " ");

      t1 = readQword(pItem) or 0 ;  t2 = readQword(t1+0x18) or 0;
        t7 = readInteger(t1+0x20) or 0;
        t7 = bAnd(t7, 0x7FFF);
        if t2~=0 and t7~=0  then
          t3 = readQword(t2+0) or 0;  t4 = readQword(t3+0) or 0;
          t5 = readQword(t4+0x10) or 0;
          s6 = readString(t5) or ""; s6 = s6:gsub("\n", ""); s6 = s6:gsub("\r", "");
        else
          s6 =  "";
        end

      local iids =
      {
       0x0000001BFDB9F655, --01 Silver
       0x000001AF7031F403, --02 Leather
       0x000001AF7031F3F9, --03 Iron Ore
       0x000001C7BCD89F8E, --04 Titanium
       0x000001C7BCD89F93, --05 Fabric
       0x000001AF70363CAF, --06 Carbon Ingot
       0x000001AF70363CB0, --07 Nickel Ingot
       0x000001AF70363CB1, --08 Tungsten Ingot
       0x00000183257CB6A1, --09 Supplies
       0x000001CC6ABA0D4C, --10 Foreign Supplies
       0x000001D1D09DC4F3, --11 Foreign Supplies (in Raid)
       0x00000183257CB6A2, --12 Raw Materials
       0x00000043E344147B, --13 Hunter Arrows
       0x000001CAC79270DF, --14 Light Arrows
       0x000001CAC79270D8, --15 Predator Arrows
       0x000001C180FBD005, --16 Yule Tokens
       0x000001CB14D75737, --17 Luxuries
       0x000001C78D91433C, --18 Texts
       0x000001C78D914115, --19 Delicacies
       0x000001C78D91434B, --20 Clothing
       0x000001E08F788505, --21 Mastery Energy
       0x000001E08F7884F1, --22 Battle Energy
       0x000001D64A570AF4, --23 Silver Deniers
       0x000001D64A571317  --24 Infamy
      }

      for i=1, #iids, 1 do
        if iids[i]==dqIID then
          res[i] = p;
          if dqIID == 0x00000043E344147B or dqIID==0x000001CAC79270DF or dqIID==0x000001CAC79270D8 then
            --Uncomment if you would like to set Arrows quatity to 777 each time on cheat activation
            --writeInteger(p,777); --Set Arrows quantity
          end
        memrec.Child[i].reinterpret();
        end
      end

      CreateInvRecs(p, names, ((p-startaddr)/dwSlotSize+1), dqIID, s5, bRunCrt, bRunTop);
      s = string.format("%016X\t%016X\t%016X\t%4d\t%s\t%s", p, pItem, dqIID, dwCount, s5, s6 )
      outputDebugString("::"..s);
    end --p
    bRunCrt = false;
  end --local INVEQ_main_lua

  local checkaddr = function()
    local pInvList = GetAddressSafe("INVEQ_pInvVector") or 0;
    local InvList  = readQword(pInvList) or 0;
    local invstart = readQword(pInvList+8) or 0;
    local invsize  = bAnd(readInteger(pInvList+0x10) or 0,0x7FFF);
    local _InvList,_invstart,_invsize;
    local call = getAddressSafe("INVEQ_getInv")

    if (not process) or (not readInteger(process)) then
      thread_inv.terminate();
      outputDebugString("::Inventory watchdog. Process terminated. EXIT.")
      return;
    end;
    if call then
      _InvList  = executeCodeEx( 0, nil, call);
      _invstart = readQword(_InvList) or 0;
      _invsize  = bAnd(readInteger(_InvList+8) or 0,0x7FFF);
      outputDebugString(string.format("::Inventory watchdog. List: %016X %016X Start: %016X %016X Size: %08X %08X", InvList,_InvList,invstart,_invstart,invsize,_invsize ));
      if (_InvList~=InvList) or (invstart~=_invstart) then
        outputDebugString("::Inventory watchdog. Altered. EXIT.")
        if thread_inv then
          thread_inv.terminate();
          synchronize(function()
            if not INVEQ_mrinfo then INVEQ_mrinfo = AddressList.createMemoryRecord(); end;
            INVEQ_mrinfo.Description   = "&gt;&gt;reactivate cheat&lt;&lt;&lt; Inventory memory was altered by the ACV engine"
            INVEQ_mrinfo.color         = 0x0000ff;
            INVEQ_mrinfo.IsGroupHeader = true;
            INVEQ_mrinfo.DontSave      = true;
            INVEQ_mrinfo.appendToEntry(memrec);
            res=nil;
            for i=0, memrec.count-1-1, 1 do
              memrec.Child[0].reinterpret();
              memrec.Child[0].appendToEntry(memrec); -- put info record on top
            end
          end) --synchronize
        end --if thread
      else --if (_InvList
        if (invsize~=_invsize) then
          outputDebugString("::Inventory watchdog. Only size altered. CONTINUE.")
        end
      end --if (_InvList
    end --if call
  end; --local checkaddr

  --Enable
  if (not process) or (not readInteger(process)) then error("Attach to the Assassin's Creed Valhalla process."); end;
  INVEQ_script_ret,INVEQ_script_dis =  autoAssemble(INVEQ_script) --global
  if not INVEQ_script_ret then return 1; end;

  local call = getAddressSafe("INVEQ_main_asm")
  if call then
    executeCodeEx( 0, nil, call);
    INVEQ_main_lua( readQword(GetAddressSafe("INVEQ_pInvVector")) or 0, GetAddressSafe("INVEQ_newmem_strings"), 0x48 );

    thread_inv = createThread(function (threadObj)
                   while (not threadObj.Terminated) do
                     sleep(10000); checkaddr();
                   end
                   outputDebugString("::Inventory watchdog. Thread "..tostring(threadObj).." terminated. EXIT. ")
                 end);
  end;--if call

[DISABLE]
  autoAssemble(INVEQ_script, INVEQ_script_dis); INVEQ_script_ret,INVEQ_script_dis = nil,nil;
  if INVEQ_mrinv  then INVEQ_mrinv.Delete();  INVEQ_mrinv  = nil; end;
  if INVEQ_mrinfo then INVEQ_mrinfo.Delete(); INVEQ_mrinfo = nil; end;
  res = nil;
  if memrec then
    for i=0, memrec.count-1, 1 do
      memrec.Child[i].reinterpret();
    end
  end
  thread_inv.terminate(); thread_inv = nil;
</AssemblerScript>
