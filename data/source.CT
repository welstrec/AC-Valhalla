        <CheatEntry>
          <ID>25746</ID>
          <Description>"+Complete Map Pack"</Description>
          <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobScanModule( scan_Vars2, $process, 48 83 3D ?? ?? ?? ?? 00 48 8B 1F 74 5B E8 ?? ?? ?? ?? 48 85 C0 74 51 45 32 F6 E8 ?? ?? ?? ?? 4C 8B C8 48 8D 0D ?? ?? ?? ?? 45 33 C0 48 8B D3 E8 ?? ?? ?? ?? 48 8B D8 48 8B 48 08 48 C1 E1 20 48 C1 F9 3F 48 23 08 74 09 E8 ?? ?? ?? ?? 44 0F B6 F0 48 8B CB E8 ?? ?? ?? ?? 45 84 F6 40 0F B6 F6 B8 01 00 00 00 0F 45 F0 48 83 C7 08 49 3B FF )

alloc( newmem_map,0x2000 )

label(main_map)
registerSymbol( newmem_map,main_map )

CreateThread( main_map )

newmem_map:
  call_GetVars2:
    mov [rsp+8], rbx
      mov rax, scan_Vars2
      mov ebx, [rax+3]
      movsxd rbx, ebx
      mov rax, [rax+rbx+8]
      mov [EM], rax
      //---
      mov rax, scan_Vars2+D
      mov ebx, [rax+1]
      movsxd rbx, ebx
      lea rax, [rax+rbx+5]
      mov [GetAW], rax
      //---
      mov rax, scan_Vars2+1A
      mov ebx, [rax+1]
      movsxd rbx, ebx
      lea rax, [rax+rbx+5]
      mov [GetTSMod], rax
      //---
      mov rax, scan_Vars2+22
      mov ebx, [rax+3]
      movsxd rbx, ebx
      lea rax, [rax+rbx+7]
      mov [CS_GI], rax
      //---
      mov rax, scan_Vars2+2F
      mov ebx, [rax+1]
      movsxd rbx, ebx
      lea rax, [rax+rbx+5]
      mov [GetI2], rax
      //---
      mov rax, scan_Vars2+48
      mov ebx, [rax+1]
      movsxd rbx, ebx
      lea rax, [rax+rbx+5]
      mov [SetTS], rax
      //---
      mov rax, scan_Vars2+54
      mov ebx, [rax+1]
      movsxd rbx, ebx
      lea rax, [rax+rbx+5]
      mov [RI], rax
    mov rbx, [rsp+8]
    ret
    align 10 CC
  call_ETS:
    mov [rsp+08], rsi
    sub rsp, 20

    mov rsi, pIID
    loop:
      cmp [EM],0
      je short SkipTimeSaver
      mov rax, GetAW
      call [rax]
      test rax, rax
      je short SkipTimeSaver
      mov rax, GetTSMod
      call [rax]
      mov r9, rax
      xor r8d, r8d
      mov rdx, [rsi]
      mov rcx, [CS_GI]
      mov rax, GetI2
      call [rax]
      mov rbx, rax
      mov rcx, [rax+8]
      shl rcx, 20
      sar rcx, 3F
      and rcx, [rax]
      je short @f
        mov rax, SetTS
        call [rax]
      @@:
        mov rcx, rbx
        mov rax, RI
        call [rax]
        SkipTimeSaver:
          add rsi, 8
          cmp [rsi], 0
          je short @f
          jmp short loop
          @@:
    add rsp, 20
    mov rsi, [rsp+8]
    ret
    align 10 CC

  main_map:
    sub rsp, 30
      call short call_GetVars2
      call short call_ETS
    add rsp, 30
    ret
    align 10 CC

  EM:
    dq 0
    align 10 CC
  GetAW:
    dq 0
    align 10 CC
  GetTSMod:
    dq 0
    align 10 CC
  CS_GI:
    dq 0
    align 10 CC
  GetI2:
    dq 0
    align 10 CC
  SetTS:
    dq 0
    align 10 CC
  RI:
    dq 0
    align 10 CC
  pIID:
    dq 000001D5B2E91BF5
    dq 000001D5B2E91BF6
    dq 000001D5B2E91BF7
    dq 000001D5B2E91BF8
    dq 0000000000000000
    align 10 CC

[DISABLE]
  unregisterSymbol(*)
  dealloc(*)

</AssemblerScript>
